{
   "name": "next-hono-admin-ui",
   "version": "0.1.0",
   "private": true,
   "scripts": {
      "dev": "next dev",
      "dev-be": "NODE_ENV=development bun run api/index.ts",
      "dev-be-qco": "NODE_ENV=development bun run api/index_qco.ts",
      "dev-full": "concurrently \"bun run dev\" \"bun run start\"",
      "dev:reset": "bunx prisma migrate reset --force --skip-seed",
      "build-be": "tsc && tsc-alias",
      "start-be": "NODE_ENV=production bun run api/index.ts",
      "start-be-qco": "NODE_ENV=production bun run api/index_qco.ts",
      "start-be2": "NODE_ENV=production bun run api/index_be2.ts",
      "build": "next build",
      "start": "next start",
      "lint": "next lint",
      "export-local": "next build && rm -rf /opt/homebrew/var/www/out && mkdir -p /opt/homebrew/var/www/admin &&  mv out/* /opt/homebrew/var/www/admin/ ",
      "typeorm": "typeorm-ts-node-commonjs"
   },
   "prisma": {
      "seed": "bun run prisma/seed.ts"
   },
