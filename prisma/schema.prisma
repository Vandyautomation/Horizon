model hourly {
  id                 BigInt    @id @default(autoincrement())
  task_id            Int?
  actual_qty         Int?
  target_qty         Int?
  hour_id            Int?
  from_datetime      DateTime?
  to_datetime        DateTime?
  created_at         DateTime?
  modified_at        DateTime?
  modified_by        String?   @db.VarChar(50)
  shift_id           Int?
  machine_id         String?   @db.VarChar(50)
  running_actual_qty Int?
  running_target_qty Int?
  cause              String?   @db.VarChar(Max)
  ooe                String?   @db.VarChar(Max)
  note               String?   @db.VarChar(Max)
  scrap              Int?      @default(0, map: "DF__hourly__scrap__5090EFD7")
  rework             Int?      @default(0, map: "DF__hourly__rework__51851410")

  @@index([from_datetime, machine_id, hour_id], map: "IDX_HOURLY_FROMDATETIME_MACHINEID_HOURID")
  @@index([id], map: "IDX_hourly_id")
  @@index([machine_id], map: "IDX_hourly_machine_id")
  @@index([task_id, from_datetime], map: "IDX_HOURLY_TASKID_FROMDATETIME")
}

