// schema.prisma

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         Int        @id @default(autoincrement())
  username   String     @unique
  firstName  String
  lastName   String
  password   String
  createdAt  DateTime   @default(now())
  modifiedAt DateTime   @updatedAt
  deletedAt  DateTime?
  createdBy  Int?
  modifiedBy Int?
  
  UserGroups   UserGroup[]
  UserLocations UserLocation[]
  UserRoles    UserRole[]
  Tickets      Ticket[]
}

model UserGroup {
  id         Int      @id @default(autoincrement())
  userId     Int
  groupId Int
  createdAt  DateTime @default(now())
  modifiedAt DateTime @updatedAt
  deletedAt  DateTime?
  createdBy  Int?
  modifiedBy Int?

  user User @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])
}

model Group {
  id        Int @id @default(autoincrement())
  name      String  @unique
  createdAt  DateTime @default(now())
  modifiedAt DateTime @updatedAt
  deletedAt  DateTime?
  createdBy  Int?
  modifiedBy Int?

  UserGroup UserGroup[]
}

model UserLocation {
  id         Int      @id @default(autoincrement())
  userId     Int
  locationId       Int  
  createdAt  DateTime @default(now())
  modifiedAt DateTime @updatedAt
  deletedAt  DateTime?
  createdBy  Int?
  modifiedBy Int?

  user User @relation(fields: [userId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

}

model Location {
  id        Int @id @default(autoincrement())
  name      String  @unique
  createdAt  DateTime @default(now())
  modifiedAt DateTime @updatedAt
  deletedAt  DateTime?
  createdBy  Int?
  modifiedBy Int?

  UserLocation UserLocation[]
}


model UserRole {
  id         Int      @id @default(autoincrement())
  userId     Int
  name       String   @unique
  type       String
  process    String  
  createdAt  DateTime @default(now())
  modifiedAt DateTime @updatedAt
  deletedAt  DateTime?
  createdBy  Int?
  modifiedBy Int?

  user User @relation(fields: [userId], references: [id])
}

model Machine {
  id          Int               @id @default(autoincrement())
  name        String            @unique
  description String
  createdAt   DateTime          @default(now())
  modifiedAt  DateTime          @updatedAt
  deletedAt   DateTime?
  createdBy   Int?
  modifiedBy  Int?
  
  MachineTransactions MachineTransaction[]

  Ticket Ticket[]
}

model MachineTransaction {
  id         Int      @id @default(autoincrement())
  machineId  Int
  statusId   Int
  createdAt  DateTime @default(now())
  deletedAt  DateTime?
  createdBy  Int?

  machine Machine @relation(fields: [machineId], references: [id])
}

model MachineStatus {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String
  createdAt   DateTime  @default(now())
  modifiedAt  DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   Int?
  modifiedBy  Int?

  Problem Problem[]
}

model ProblemGroup {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  createdAt  DateTime @default(now())
  modifiedAt DateTime @updatedAt
  deletedAt  DateTime?
  createdBy  Int?
  modifiedBy Int?

  Problems Problem[]
}

model Problem {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  statusId   Int
  groupId    Int
  createdAt  DateTime @default(now())
  modifiedAt DateTime @updatedAt
  deletedAt  DateTime?
  createdBy  Int?
  modifiedBy Int?

  group ProblemGroup @relation(fields: [groupId], references: [id])
  status MachineStatus @relation(fields: [statusId], references: [id])

  ProblemAction ProblemAction[]
}

model ProblemAction {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  problemId     Int
  picPersonnelId Int
  isEscalated   Boolean
  createdAt     DateTime @default(now())
  modifiedAt    DateTime @updatedAt
  deletedAt     DateTime?
  createdBy     Int?
  modifiedBy    Int?

  problem Problem @relation(fields: [problemId], references: [id])

  Ticket Ticket[]
}

model Ticket {
  id            Int            @id @default(autoincrement())
  machineId     Int
  problemActionId Int
  createdAt     DateTime       @default(now())
  modifiedAt    DateTime       @updatedAt
  deletedAt     DateTime?
  createdBy     Int?
  modifiedBy    Int?

  machine Machine @relation(fields: [machineId], references: [id])
  problemAction ProblemAction @relation(fields: [problemActionId], references: [id])
  TicketNotes   TicketNote[]

  User User[]

  TicketTransaction TicketTransaction[]
}

model TicketNote {
  id          Int       @id @default(autoincrement())
  ticketId    Int
  notes       String
  createdAt   DateTime  @default(now())
  modifiedAt  DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   Int?
  modifiedBy  Int?

  ticket Ticket @relation(fields: [ticketId], references: [id])
}

model TicketTransaction {
  id          Int       @id @default(autoincrement())
  ticketId    Int
  type        String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  createdBy   Int?

  ticket Ticket @relation(fields: [ticketId], references: [id])
}



model PO_master_data_SCM {
  id       Int      @id @default(autoincrement())
  po_name  String   @unique
  material_id String 
  scaleTasks scale_tasks[]
}

model scale_tasks {
  id            Int                @id @default(autoincrement())
  po_name       String
  material_id   String
  status        String
  scale_asset_id Int
  total_consumption Decimal       @default(0.0)
  created_at    DateTime           @default(now())
  modified_at   DateTime?
  deleted_at    DateTime?
  
  po             PO_master_data_SCM @relation(fields: [po_name], references: [po_name])
  scaleAsset     scale_assets       @relation(fields: [scale_asset_id], references: [id])
  transactions   scale_transaction[]
  measurements   scale_measurements[]
}

model scale_transaction {
  id         Int          @id @default(autoincrement())
  task_id    Int
  type       String
  created_at DateTime     @default(now())
  deleted_at DateTime?

  task       scale_tasks  @relation(fields: [task_id], references: [id])
}

model scale_measurements {
  id             Int           @id @default(autoincrement())
  task_id        Int
  scale_asset_id Int
  weight         Decimal       @db.Decimal(18, 2)
  created_at     DateTime      @default(now())
  deleted_at     DateTime?

  task           scale_tasks   @relation(fields: [task_id], references: [id], onUpdate: NoAction)
  scaleAsset     scale_assets  @relation(fields: [scale_asset_id], references: [id])
}

model scale_assets {
  id          Int                  @id @default(autoincrement())
  name        String
  description String
  location    String
  created_at  DateTime             @default(now())
  modified_at DateTime?
  deleted_at  DateTime?

  scaleTasks  scale_tasks[]
  measurements scale_measurements[]
}
